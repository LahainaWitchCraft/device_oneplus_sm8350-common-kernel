   pm8008_en-supply = <&PM8008I_EN>;
   vdd_l1_l2-supply = <&S8B>;
   vdd_l3_l4-supply = <&BOB>;
   vdd_l5-supply = <&S1B>;
   vdd_l6-supply = <&BOB>;
   vdd_l7-supply = <&BOB>;

   L1I: pm8008i_l1: regulator@4000 {
    reg = <0x4000>;
