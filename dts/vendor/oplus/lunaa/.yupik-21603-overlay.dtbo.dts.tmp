                /delete-node/ cooling-maps;
        };
};
# 4 "../arch/arm64/boot/dts/vendor/oplus/lunaa/yupik-21603-overlay.dtsi" 2
# 1 "../arch/arm64/boot/dts/vendor/oplus/lunaa/sensor/luna-a-sensor-21603.dtsi" 1





&soc {

        sensor_fb: sensor_fb {
            compatible = "oplus,sensor-feedback";
        };

        oplus_sensor: oplus_sensor {
                compatible = "oplus,sensor-devinfo";
                als-row-coe = <110>;

                gsensor@0 {
                        sensor-name = <0x80>;
                        sensor-direction = <7>;
                        sensor-index = <0>;
                        sensor-type = <0>;
                };
                gsensor@1 {
                        sensor-name = <0x04>;
                        sensor-direction = <3>;
                        sensor-index = <1>;
                        sensor-type = <0>;
                };

                msensor@0 {
                        sensor-name = <0x01>;
                        sensor-direction = <0>;
                        sensor-index = <0>;
                        sensor-type = <2>;
                        parameter-number= <18>;
                        soft-mag-parameter = <9952 0 926 0 308 0 1316 0 6893 0 5 1 649 0 1665 1 9370 0>;
                };
                msensor@1 {
                        sensor-name = <0x02>;
                        sensor-direction = <0>;
                        sensor-index = <1>;
                        sensor-type = <2>;
                        parameter-number= <18>;
                        soft-mag-parameter = <9952 0 926 0 308 0 1316 0 6893 0 5 1 649 0 1665 1 9370 0>;
                };


                lsensor@0 {
                        sensor-name = <0x08>;
                        sensor-index = <0>;
                        sensor-type = <3>;
                        bus-number = <2>;
                        irq-number = <142>;
                        als-type = <2>;
                        is-unit-device = <1>;
                        is-als-dri = <1>;
                        als-factor = <110>;
                        is_als_initialed = <0>;
                        als_buffer_length = <8>;
                };
                psensor@0 {
                        sensor-name = <0x08>;
                        sensor-index = <0>;
                        sensor-type = <4>;
                        bus-number = <2>;
                        irq-number = <142>;
                        ps-cail-type = <1>;
                        ps-type = <1>;
                        is_ps_initialzed = <0>;

                        parameter-number = <2>;
                        sensor-reg = <0x81 0x70>;

                };
# 84 "../arch/arm64/boot/dts/vendor/oplus/lunaa/sensor/luna-a-sensor-21603.dtsi"
                pickup_detect {
                        sensor-type = <0>;
                        is-virtual-sensor;
                        is-need-prox = <1>;
                        prox-type = <0>;
                };
                lux_aod {
                        sensor-type = <1>;
                        is-virtual-sensor;
                        thrd-low = <30>;
                        thrd-high = <300>;
                        als-type = <1>;
                };
                fp_display {
                        sensor-type = <3>;
                        is-virtual-sensor;
                        prox-type = <0>;
                };
                free_fall {
                        sensor-type = <4>;
                        is-virtual-sensor;
                };
        };

};
# 5 "../arch/arm64/boot/dts/vendor/oplus/lunaa/yupik-21603-overlay.dtsi" 2

# 1 "../arch/arm64/boot/dts/vendor/oplus/lunaa/luna_nfc_st54.dtsi" 1
# 13 "../arch/arm64/boot/dts/vendor/oplus/lunaa/luna_nfc_st54.dtsi"
&soc {

    nfc_chipset {
        compatible = "oplus-nfc-chipset";
        chipset-21603 = "ST54H";
        chipset-21604 = "ST54H";
 chipset-21675 = "ST21H";
        chipset-21676 = "ST21H";
    };
};



&qupv3_se9_i2c {
    status = "ok";
    #address-cells = <1>;
    #size-cells = <0>;
    st21nfc@08 {
        compatible = "st,st21nfc";
        reg = <0x08>;
        irq-gpios = <&tlmm 41 0x00>;
        reset-gpios = <&tlmm 38 0x00>;
        clkreq-gpios = <&tlmm 39 0x00>;
        interrupt-parent = <&tlmm>;
        interrupts = <41 0>;
        interrupt-names = "nfc_irq";
        pinctrl-names = "nfc_active", "nfc_suspend";
        pinctrl-0 = <&nfc_int_active &nfc_enable_active>;
        pinctrl-1 = <&nfc_int_suspend &nfc_enable_suspend>;
    };
};

&qupv3_se12_spi {
        status = "okay";

        st54spi: st54spi@0 {
                compatible = "st,st54spi";
                reg = <0>;
                spi-max-frequency = <1000000>;


                gpio-power_nreset-std = <&tlmm 11 0x00>;


                power_mode = "ST54H";

                pinctrl-names = "qupv3_se12_spi_sleep", "qupv3_se12_spi_active";
                pinctrl-0 = <&qupv3_se12_spi_sleep>;
                pinctrl-1 = <&qupv3_se12_spi_active>;

                status = "okay";
        };
};
# 7 "../arch/arm64/boot/dts/vendor/oplus/lunaa/yupik-21603-overlay.dtsi" 2

# 1 "../scripts/dtc/include-prefixes/dt-bindings/input/qcom,hv-haptics.h" 1
# 9 "../arch/arm64/boot/dts/vendor/oplus/lunaa/yupik-21603-overlay.dtsi" 2

&L12C {
    regulator-max-microvolt = <1800000>;
    qcom,init-voltage = <1800000>;
    qcom,proxy-consumer-enable;
    qcom,proxy-consumer-current = <243000>;
};

&L5I {
    regulator-min-microvolt = <1500000>;
    regulator-man-microvolt = <1800000>;
    qcom,min-dropout-voltage = <70000>;
};

&L13C {
    regulator-max-microvolt = <3200000>;
    qcom,init-voltage = <3000000>;
    qcom,proxy-consumer-enable;
    qcom,proxy-consumer-current = <10000>;
};
&soc {
    dsi_panel_pwr_supply_vddr: dsi_panel_pwr_supply_vddr {
        #address-cells = <1>;
        #size-cells = <0>;

        qcom,panel-supply-entry@0 {
            reg = <0>;
            qcom,supply-name = "vddio";
            qcom,supply-min-voltage = <1800000>;
            qcom,supply-max-voltage = <1800000>;
            qcom,supply-enable-load = <60700>;
            qcom,supply-disable-load = <80>;
            qcom,supply-post-on-sleep = <0>;
        };
        qcom,panel-supply-entry@1 {
            reg = <1>;
            qcom,supply-name = "vdd";
            qcom,supply-min-voltage = <3000000>;
            qcom,supply-max-voltage = <3000000>;
            qcom,supply-enable-load = <10000>;
            qcom,supply-disable-load = <0>;
            qcom,supply-post-on-sleep = <0>;
        };
        qcom,panel-supply-entry@2 {
            reg = <2>;
            qcom,supply-name = "vddr";
            qcom,supply-min-voltage = <1504000>;
            qcom,supply-max-voltage = <1504000>;
            qcom,supply-enable-load = <60700>;
            qcom,supply-disable-load = <80>;
            qcom,supply-post-on-sleep = <11>;
        };
    };
};

&sde_dsi {
    vddio-supply = <&L12C>;
