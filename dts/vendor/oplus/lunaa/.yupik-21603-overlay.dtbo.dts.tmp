                usb-phy = <&usb2_phy0>, <&usb_nop_phy>;
                snps,usb2-lpm-disable;
                maximum-speed = "high-speed";
                dr_mode = "otg";
        };
};

&usb1 {
        status = "disabled";
        dwc3@8c00000 {
                status = "disabled";
        };
};

&usb2_phy0 {
