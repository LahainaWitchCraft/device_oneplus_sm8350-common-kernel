    oplus,dsi-dc-brightness = <0 0xff>,
            <1 0xfe>,
            <2 0xfc>,
            <3 0xfb>,
            <4 0xf9>,
            <5 0xf9>,
            <8 0xf6>,
            <10 0xf5>,
