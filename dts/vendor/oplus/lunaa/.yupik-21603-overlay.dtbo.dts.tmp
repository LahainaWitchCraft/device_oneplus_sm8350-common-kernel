  compatible = "gpio-keys";
  label = "gpio-keys";

  pinctrl-names = "default";
  pinctrl-0 = <&key_vol_up_default>;

  vol_up {
   label = "volume_up";
   gpios = <&pm7325_gpios 6 1>;
   linux,input-type = <1>;
