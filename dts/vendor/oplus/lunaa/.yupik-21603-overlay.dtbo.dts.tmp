&soc {
 oplus,adsp-voocphy {
  compatible = "oplus,adsp-voocphy";
 };

 oplus,track-charge {
  compatible = "oplus,track-charge";
  track,fast_chg_break_t_thd = <1000>;
  track,general_chg_break_t_thd = <200>;
  track,voocphy_type = <1>;
  track,wired_max_power = <65000>;
  track,wired_fast_chg_scheme = <1>;
 };
};

&tlmm {
 chg_qupv3_se3_2uart_active: chg_qupv3_se3_2uart_active {
  mux {
   pins = "gpio22", "gpio23";
   function = "qup05";
  };

  config {
   pins = "gpio22", "gpio23";
   drive-strength = <2>;
   bias-disable;
  };
 };

 chg_qupv3_se3_2uart_sleep: chg_qupv3_se3_2uart_sleep {
  mux {
   pins = "gpio22", "gpio23";
   function = "gpio";
  };

  config {
   pins = "gpio22", "gpio23";
   drive-strength = <2>;
   input-enable;
   bias-pull-down;
  };
 };
};

&pm7325_gpios {
 usbtemp_l_gpio_default: usbtemp_l_gpio_default {
  pins = "gpio3";
  function = "normal";
  bias-high-impedance;
    };
 usbtemp_r_gpio_default: usbtemp_r_gpio_default {
        pins = "gpio5";
  function = "normal";
        bias-high-impedance;
    };
};

&pmk8350_vadc {
 usb_temp_adc {
  reg = <(1 << 8 | 0x4b)>;
  label = "usb_temp_adc";
  qcom,pre-scaling = <1 1>;
  qcom,ratiometric;
  qcom,hw-settle-time = <200>;
  oplus,cust_type = <0>;
  oplus,cust_scale_fn_type = <5>;
 };
 usb_supplementary_temp_adc {
  reg = <(1 << 8 | 0x4d)>;
  label = "usb_supplementary_temp_adc";
  qcom,pre-scaling = <1 1>;
  qcom,ratiometric;
  qcom,hw-settle-time = <200>;
  oplus,cust_type = <0>;
  oplus,cust_scale_fn_type = <5>;
 };
};

&battery_charger {
 io-channels = <&pmk8350_vadc (1 << 8 | 0x4b)>,
     <&pmk8350_vadc (1 << 8 | 0x4d)>;
 io-channel-names = "usb_temp_adc",
      "usb_supplementary_temp_adc";
};

&pm8350c_gpios {
 dischg_enable: dischg_enable {
  pins = "gpio9";
  function = "normal";
  bias-disable;
  power-source = <0>;
  output-high;
  qcom,drive-strength = <3>;
 };

 dischg_disable: dischg_disable {
  pins = "gpio9";
  function = "normal";
  bias-disable;
  power-source = <0>;
  output-low;
  qcom,drive-strength = <3>;
 };
};

