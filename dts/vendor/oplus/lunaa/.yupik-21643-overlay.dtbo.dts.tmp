&wsa_spkr_en2 {
 status = "disabled";
};


&soc {

        oplus,track-charge {
  compatible = "oplus,track-charge";
  track,fast_chg_break_t_thd = <1000>;
  track,general_chg_break_t_thd = <200>;
  track,voocphy_type = <4>;
  track,wired_max_power = <30000>;
  track,wired_fast_chg_scheme = <4>;
 };
};

&tlmm {
 charging_reset_active: charging_reset_active {
  mux {
   pins = "gpio63";
   function = "gpio";
  };

  config {
   pins = "gpio63";
   drive-strength = <2>;
   bias-pull-up;
  };
 };

 charging_reset_sleep: charging_reset_sleep {
  mux {
   pins = "gpio63";
   function = "gpio";
  };

  config {
   pins = "gpio63";
   drive-strength = <2>;
   bias-pull-down;
  };
 };
 charging_switch1_active: charging_switch1_active {
  mux {
   pins = "gpio2";
   function = "gpio";
  };
  config {
   pins = "gpio2";
   bias-pull-up;
   drive-strength = <2>;
   output-high;
  };
 };

 charging_switch1_sleep: charging_switch1_sleep {
  mux {
   pins = "gpio2";
   function = "gpio";
  };
  config {
   pins = "gpio2";
   bias-pull-up;
   drive-strength = <2>;
   output-low;
  };
 };

 chargerid_switch_active: chargerid_switch_active {
  mux {
   pins = "gpio62";
   function = "gpio";
  };
  config {
   pins = "gpio62";
   bias-pull-up;
   drive-strength = <2>;
   output-high;
  };
 };

 chargerid_switch_sleep: chargerid_switch_sleep {
  mux {
   pins = "gpio62";
   function = "gpio";
  };
  config {
   pins = "gpio62";
   bias-pull-down;
   drive-strength = <2>;
   output-low;
  };
 };

 chargerid_switch_default: chargerid_switch_default {
  mux {
   pins = "gpio62";
   function = "gpio";
  };

  config {
   pins = "gpio62";
   drive-strength = <2>;
   bias-disable;
  };
 };

 ship_sleep: ship_sleep {
  mux {
   pins = "gpio47";
   function = "gpio";
  };

  config {
   pins = "gpio47";
   drive-strength = <2>;
   bias-pull-down;
   output-low;
  };
 };

 ship_active: ship_active {
  mux {
   pins = "gpio47";
   function = "gpio";
  };

  config {
   pins = "gpio47";
   drive-strength = <2>;
   bias-pull-up;
   output-high;
  };
 };

 chg_qupv3_se3_2uart_active: chg_qupv3_se3_2uart_active {
  mux {
   pins = "gpio22", "gpio23";
   function = "qup05";
  };

  config {
   pins = "gpio22", "gpio23";
   drive-strength = <2>;
   bias-disable;
  };
 };

 chg_qupv3_se3_2uart_sleep: chg_qupv3_se3_2uart_sleep {
  mux {
   pins = "gpio22", "gpio23";
   function = "gpio";
  };

  config {
   pins = "gpio22", "gpio23";
   drive-strength = <2>;
   input-enable;
   bias-pull-down;
  };
 };
 charging_clock_active: charging_clock_active {
  mux {
   pins = "gpio173";
   function = "gpio";
  };

  config {
   pins = "gpio173";
   drive-strength = <2>;
   bias-pull-down;
  };
 };

 charging_clock_sleep: charging_clock_sleep {
  mux {
   pins = "gpio173";
   function = "gpio";
  };

  config {
   pins = "gpio173";
   drive-strength = <2>;
   bias-pull-up;
  };
 };

 charging_data_active: charging_data_active {
  mux {
   pins = "gpio174";
   function = "gpio";
  };

  config {
   pins = "gpio174";
   drive-strength = <8>;
   bias-pull-down;
  };
 };

 charging_data_sleep: charging_data_sleep {
  mux {
   pins = "gpio174";
   function = "gpio";
  };

  config {
   pins = "gpio174";
   drive-strength = <2>;
   bias-pull-down;
  };
 };
};

&pm8350c_gpios {
 dischg_enable: dischg_enable {
  pins = "gpio9";
  function = "normal";
  bias-disable;
  power-source = <0>;
  output-high;
  qcom,drive-strength = <3>;
 };

 dischg_disable: dischg_disable {
  pins = "gpio9";
  function = "normal";
  bias-disable;
  power-source = <0>;
  output-low;
  qcom,drive-strength = <3>;
 };

 vooc_asic_id_active: vooc_asic_id_active {
  pins = "gpio7";
  function = "normal";
  bias-pull-up;
  input-enable;
  power-source = <1>;
 };

 vooc_asic_id_sleep: vooc_asic_id_sleep {
  pins = "gpio7";
  function = "normal";
  bias-pull-down;
  input-enable;
  power-source = <1>;
 };
};

&pm7325_gpios {
 usbtemp_l_gpio_default: usbtemp_l_gpio_default {
  pins = "gpio3";
  function = "normal";
  bias-high-impedance;
 };
 usbtemp_r_gpio_default: usbtemp_r_gpio_default {
  pins = "gpio5";
  function = "normal";
  bias-high-impedance;
 };
};

&pmk8350_vadc {
 compatible = "qcom,spmi-adc7-walle";
 usb_temp_adc {
  reg = <(1 << 8 | 0x4b)>;
  label = "usb_temp_adc";
  qcom,pre-scaling = <1 1>;
  qcom,ratiometric;
  qcom,hw-settle-time = <200>;
  oplus,cust_type = <0>;
  oplus,cust_scale_fn_type = <5>;
 };
 usb_supplementary_temp_adc {
  reg = <(1 << 8 | 0x4d)>;
  label = "usb_supplementary_temp_adc";
  qcom,pre-scaling = <1 1>;
  qcom,ratiometric;
  qcom,hw-settle-time = <200>;
  oplus,cust_type = <0>;
  oplus,cust_scale_fn_type = <5>;
 };
};

&battery_charger {
 io-channels = <&pmk8350_vadc (1 << 8 | 0x4b)>,
     <&pmk8350_vadc (1 << 8 | 0x4d)>;
 io-channel-names = "usb_temp_adc",
      "usb_supplementary_temp_adc";
};

&battery_charger {

 oplus,chg_ops = "plat-pmic";
 qcom,smart_charging_screenoff;
 qcom,input_current_charger_ma = <2000>;
 qcom,pd_input_current_charger_ma = <3000>;
 qcom,qc_input_current_charger_ma = <2000>;
 qcom,input_current_usb_ma = <500>;
 qcom,input_current_cdp_ma = <1500>;
 qcom,input_current_led_ma = <1200>;
 qcom,input_current_led_ma_high = <1800>;
 qcom,input_current_led_ma_warm = <1800>;
 qcom,input_current_led_ma_normal = <2000>;
 qcom,led_warm_bat_decidegc = <350>;
 qcom,led_high_bat_decidegc = <370>;
