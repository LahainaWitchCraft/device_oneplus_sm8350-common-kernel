  pinctrl-names = "default";
  pinctrl-0 = <&key_vol_down_default>;

  vol_up {
   label = "volume_down";
   gpios = <&pm7325_gpios 6 1>;
   linux,input-type = <1>;
   linux,code = <114>;
   gpio-key,wakeup;
   debounce-interval = <15>;
   linux,can-disable;
  };
 };

        shell_front {
                compatible = "oplus,shell-temp";
        };

        shell_frame {
                compatible = "oplus,shell-temp";
        };

        shell_back {
                compatible = "oplus,shell-temp";
        };
};


&pm7325_gpios {
 key_vol_down {
  key_vol_down_default: key_vol_down_default {
   pins = "gpio6";
   function = "normal";
   input-enable;
   bias-pull-up;
   power-source = <1>;
  };
 };
};


&firmware {
