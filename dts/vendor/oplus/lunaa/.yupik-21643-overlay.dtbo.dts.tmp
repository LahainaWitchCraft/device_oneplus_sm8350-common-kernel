&sdhc_2 {
 cd-gpios = <&tlmm 91 0>;
 status = "ok";
 };


&tlmm {



 pmx_ts_int_active_oplus {
  ts_int_active: ts_int_active {
   mux {
    pins = "gpio81";
    function = "gpio";
   };

   config {
    pins = "gpio81";
    drive-strength = <8>;
    bias-disable;
    input-enable;
   };
  };
 };

 pmx_ts_int_suspend_oplus {
  ts_int_suspend1: ts_int_suspend1 {
   mux {
    pins = "gpio81";
    function = "gpio";
   };

   config {
    pins = "gpio81";
    drive-strength = <8>;

    bias-pull-up;
    input-enable;
   };
  };
 };

 pmx_ts_reset_active_oplus {
  ctp_ts_reset_poweron: ts_reset_active {
   mux {
    pins = "gpio105";
    function = "gpio";
   };

   config {
    pins = "gpio105";
    drive-strength = <8>;
    output-low;
    bias-disable;
   };
  };
 };

 pmx_ts_reset_suspend_oplus {
  ctp_ts_reset_poweroff: ts_reset_suspend1 {
   mux {
    pins = "gpio105";
    function = "gpio";
   };

   config {
    pins = "gpio105";
    drive-strength = <2>;
    bias-pull-down;
   };
  };
 };

};





&tlmm {
  silead_fp{
   gpio_silead_irq_default: gpio_silead_irq_default {
    mux {
     pins = "gpio34";
     function = "gpio";
    };
    config {
     pins = "gpio34";
     drive-strength = <2>;
     bias-disable;
     input-enable;
    };
   };
  };

};

&pm8350c_gpios {
 gpio_id0_default: gpio_id0_default {
  pins = "gpio4";
  function = "normal";
  qcom,drive-strength = <2>;
  input-enable;
  bias-pull-down;
  power-source = <0>;
 };
};


&thermal_soc_cooling_maps {
       socd_cpu4 {
               trip = <&socd_trip>;
               cooling-device = <&cpu4_isolate 0 0>;
       };

       socd_cpu5 {
               trip = <&socd_trip>;
               cooling-device = <&cpu5_isolate 0 0>;
       };

       socd_cpu6 {
               trip = <&socd_trip>;
               cooling-device = <&cpu6_isolate 0 0>;
       };

       socd_cpu7 {
               trip = <&socd_trip>;
      cooling-device = <&cpu7_isolate 0 0>;
       };
};

&soc {
 oplus_fp_common {
  compatible = "oplus,fp_common";
  oplus,fp_gpio_num = <1>;
        oplus,fp_gpio_0 = <&pm8350c_gpios 4 0x00>;
  pinctrl-names = "gpio_id0_default";
  pinctrl-0 = <&gpio_id0_default>;
  oplus,one_gpio_for_three_ic = <1>;
  silead_6159 {
   oplus,fp-id = <0>;
   vendor-chip = <19>;
   eng-menu = "-1,-1";
   chip-name = "S_gsl6159";
  };
 };

    silead_fp {
        status = "ok";
        compatible = "sil,silead_fp";
        qcom,qup-id = <15>;
        interrupt-parent = <&tlmm>;
        interrupts = <34 0>;
  avdd-supply = <&L13C>;
  ldo-supply = <&L5I>;
        rst-gpios = <&tlmm 61 0x00>;
        irq-gpios = <&tlmm 34 0x00>;
  spi-max-frequency = <4800000>;
        pinctrl-names = "default";
        pinctrl-0 = <&gpio_silead_irq_default>;

    };


    oplus_secure_common {
        compatible = "oplus,secure_common";
        oplus,sec_reg_num = <0x780728>;
        oplus,sec_en_anti_reg = <0x7801D4>;
        oplus,sec_override1_reg = <0x7860C0>;
        oplus,override1_en_value = <0x1>;
    };
};

&reserved_memory {

 cdsp_secure_heap_mem: cdsp_secure_heap@81800000 {
  no-map;
  reg = <0x0 0x81800000 0x0 0x0>;
 };



 non_secure_display_memory: non_secure_display_region {
  compatible = "shared-dma-pool";
  alloc-ranges = <0x0 0x00000000 0x0 0xffffffff>;
  reusable;
  alignment = <0x0 0x400000>;
  size = <0x0 0x0>;
 };


};

&removed_mem {
 no-map;

 reg = <0x0 0xc0000000 0x0 0x8E00000>;
};
