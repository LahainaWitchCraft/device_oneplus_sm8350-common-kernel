};

&thermal_zones {
 socd {
  thermal_soc_cooling_maps:cooling-maps {
   socd_cpu4 {
    trip = <&socd_trip>;
    cooling-device = <&cpu4_isolate 1 1>;
   };

   socd_cpu5 {
    trip = <&socd_trip>;
    cooling-device = <&cpu5_isolate 1 1>;
   };

   socd_cpu6 {
    trip = <&socd_trip>;
    cooling-device = <&cpu6_isolate 1 1>;
   };

   socd_cpu7 {
    trip = <&socd_trip>;
    cooling-device = <&cpu7_isolate 1 1>;
   };
  };
 };

 pm7325b-ibat-lvl0 {
  trips {
   ibat-lvl0 {
    temperature = <5000>;
   };
  };
 };

 pm7325b-bcl-lvl0 {
  cooling-maps {
   vbat_cpu4 {
    trip = <&b_bcl_lvl0>;
    cooling-device = <&cpu4_isolate 1 1>;
   };

   vbat_cpu5 {
    trip = <&b_bcl_lvl0>;
    cooling-device = <&cpu5_isolate 1 1>;
   };

   vbat_cpu6 {
    trip = <&b_bcl_lvl0>;
    cooling-device = <&cpu6_isolate 1 1>;
   };

   vbat_cpu7 {
    trip = <&b_bcl_lvl0>;
