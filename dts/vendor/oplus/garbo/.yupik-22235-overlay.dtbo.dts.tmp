# 1 "../arch/arm64/boot/dts/vendor/oplus/garbo/oplus_uff_fingerprint_garbo.dtsi" 1
&soc {

 fingerprint_dev {
  status = "ok";
  compatible = "oplus,fp_spi";
  interrupt-parent = <&tlmm>;
  interrupts = <34 0>;
  power-mode = <2> ;
  gpio-power = <&tlmm 35 0x0>;
  uff,gpio_irq = <&tlmm 34 0x1>;
  uff,gpio_reset = <&tlmm 61 0x0>;
  pinctrl-names = "default";
  pinctrl-0 = <&fp_irq_gpio_default>,<&fp_reset_gpio_default>;
  notify_tpinfo_flag = <1>;
  power-num = <1>;
  power_source_1 {
   power-mode = <2>;
   power-name = "gpio-power";
   poweron-level = <1>;
   delay-time = <0>;
  };
 };

};

&tlmm {

 fingerprint_dev{
  fp_irq_gpio_default: fp_irq_gpio_default {
   mux {
    pins = "gpio34";
    function = "gpio";
   };
   config {
    pins = "gpio34";
    drive-strength = <2>;
    bias-disable;
    input-enable;
   };
  };

  fp_reset_gpio_default: fp_reset_gpio_default {
   mux {
    pins = "gpio61";
    function = "gpio";
   };
   config {
    pins = "gpio61";
    drive-strength = <2>;
    bias-disable;
    output-low;
   };
  };
 };

};
