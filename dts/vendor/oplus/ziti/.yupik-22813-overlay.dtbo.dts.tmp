&qupv3_se3_i2c {
 status = "okay";
 qcom,clk-freq-out = <400000>;
 qcom,noise-rjct-scl = <3>;
 qcom,noise-rjct-sda = <3>;

 mp2650-charger@5c {
  status = "okay";
  compatible = "oplus,mp2650-charger";
  reg = <0x5c 0>;

  qcom,mps_otg_en-gpio = <&tlmm 100 0x00>;
  pinctrl-names = "mps_otg_en_active", "mps_otg_en_sleep", "mps_otg_en_default", "default";
  pinctrl-0 = <&mps_otg_en_active>;
  pinctrl-1 = <&mps_otg_en_sleep>;
  pinctrl-2 = <&mps_otg_en_default>;
  pinctrl-3 = <&mp2650_int>;
 };

 da9313-divider@68 {
  status = "okay";
  compatible = "oplus,da9313-divider";
  reg = <0x68 0>;
  oplus,da9313-hwid-gpio = <&tlmm 101 0x00>;
  pinctrl-names = "da9313_hwid_active", "da9313_hwid_sleep", "da9313_hwid_default", "default";
  pinctrl-0 = <&da9313_hwid_active>;
  pinctrl-1 = <&da9313_hwid_sleep>;
  pinctrl-2 = <&da9313_hwid_default>;
  pinctrl-3 = <&da9313_int>;
 };
};

&qupv3_se8_i2c {
 status = "okay";
 qcom,clk-freq-out = <100000>;
 pinctrl-names = "default", "sleep", "pulldown", "pullup";
 pinctrl-0 = <&qupv3_se8_i2c_active>;
 pinctrl-1 = <&qupv3_se8_i2c_sleep>;
 pinctrl-2 = <&qupv3_se8_i2c_pulldown>;
 pinctrl-3 = <&qupv3_se8_i2c_pullup>;

 bq27541-battery@55 {
  status = "okay";
