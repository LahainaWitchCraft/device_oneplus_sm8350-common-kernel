    bias-disable;
   };
  };

  qupv3_se13_spi_cs_active: qupv3_se13_spi_cs_active {
   mux {
    pins = "gpio55";
    function = "qup15";
   };

   config {
    pins = "gpio55";
    drive-strength = <6>;
    bias-disable;
   };
  };

  qupv3_se13_spi_sleep: qupv3_se13_spi_sleep {
   mux {
    pins = "gpio52", "gpio53",
      "gpio54";
    function = "gpio";
   };

   config {
    pins = "gpio52", "gpio53",
      "gpio54";
    drive-strength = <6>;
    bias-disable;
   };
  };

  qupv3_se13_spi_cs_sleep: qupv3_se13_spi_cs_sleep {
   mux {
    pins = "gpio55";
    function = "gpio";
   };

   config {
    pins = "gpio55";
    drive-strength = <6>;
    bias-disable;
    output-high;
   };
  };
 };
};


