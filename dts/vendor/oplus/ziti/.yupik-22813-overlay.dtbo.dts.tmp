  qcom,tx_swr_ch_map = <0 18 0x1 0 34>,
   <0 19 0x2 0 35>,
   <1 20 0x1 0 38>,
   <1 21 0x2 0 39>,
   <2 22 0x1 0 36>,
   <2 23 0x2 0 37>,
   <2 17 0x4 0 40>,
   <2 24 0x4 0 40>,
   <2 25 0x8 0 41>,
   <3 26 0x1 0 42>,
   <3 27 0x2 0 43>,
   <3 28 0x4 0 44>,
   <3 29 0x8 0 45>;

  qcom,wcd-rst-gpio-node = <&wcd93xx_rst_gpio>;
  qcom,rx-slave = <&wcd938x_rx_slave>;
