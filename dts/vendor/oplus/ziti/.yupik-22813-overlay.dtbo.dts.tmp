# 9 "../arch/arm64/boot/dts/vendor/oplus/ziti/yupik-22813-overlay.dts" 2
# 1 "../arch/arm64/boot/dts/vendor/oplus/ziti/sensor/ziti-sensor-common.dtsi" 1





&soc {

        sensor_fb: sensor_fb {
            compatible = "oplus,sensor-feedback";
        };
        consumer_ir_core: consumer_ir_core {
  compatible = "oplus,kookong_ir_core";
  status = "okay";

  vdd-type = <1>;
  vdd-min-vol = <3060>;
  vdd-max-vol = <3060>;
 };

        oplus_sensor: oplus_sensor {
                compatible = "oplus,sensor-devinfo";
                als-row-coe = <110>;

                gsensor@0 {
                        sensor-name = <0x20>;
                        sensor-direction = <7>;
                        sensor-index = <0>;
                        sensor-type = <0>;
                        use-sois = <1>;
                };

                msensor@0 {
                        sensor-name = <0x04>;
                        sensor-direction = <4>;
                        sensor-index = <0>;
                        sensor-type = <2>;
                        parameter-number= <18>;
                        soft-mag-parameter = <9374 0 1213 0 226 1 1096 0 9214 0 182 1 493 0 677 1 10723 0>;
                };


  lsensor@0 {
   sensor-name = <0x08>;
   sensor-index = <0>;
   sensor-type = <3>;
   bus-number = <2>;
   irq-number = <142>;
   als-type = <2>;
   is-unit-device = <1>;
   is-als-dri = <0>;
   als-factor = <180>;
   is_als_initialed = <0>;
   als_buffer_length = <8>;
   use_lb_algo = <1>;
   lcd_type = <0>;
   linear_comp_scope = <1407>;
   linear_comp_intercept = <19873>;
   temp_lux = <0>;
   coef = <730>;
   bal_coef = <280>;
   ir_coef_stage_0 = <100>;
   ir_coef_stage_1 = <180>;
   ir_coef_stage_2 = <250>;
   ir_coef_stage_3 = <400>;
   ir_coef_val_0 = <1000>;
   ir_coef_val_1 = <500>;
   ir_coef_val_2 = <280>;
   ir_coef_val_3 = <180>;
   ir_coef_val_4 = <150>;
  };
  psensor@0 {
   sensor-name = <0x08>;
   sensor-index = <0>;
   sensor-type = <4>;
   bus-number = <2>;
   irq-number = <142>;
   ps-type = <1>;
   low_step = <300>;
   high_step = <400>;
   low_limit = <600>;
   high_limit = <1050>;
   dirty_low_step = <300>;
   dirty_high_step = <400>;
   ps_dirty_limit = <1800>;
   ps_ir_limit = <2000>;
   ps_adjust_min = <0>;
   ps_adjust_max = <1850>;
   sampling_count = <5>;
   step_max = <400>;
   step_min = <100>;
   step_div = <2000>;
   anti_shake_delta = <70>;
   dynamic_cali_max = <2000>;
   raw2offset_radio = <1000>;
   offset_max = <60000>;
   offset_range_min = <0>;
   offset_range_max = <65535>;
   force_cali_limit = <2000>;
   cali_jitter_limit = <20>;
   cal_offset_margin = <3000>;
   parameter-number = <2>;
   sensor-reg = <0x03 0x60>;
  };
# 114 "../arch/arm64/boot/dts/vendor/oplus/ziti/sensor/ziti-sensor-common.dtsi"
                pickup_detect {
                        sensor-type = <0>;
                        is-virtual-sensor;
                        is-need-prox = <1>;
                        prox-type = <0>;
                };
                lux_aod {
                        sensor-type = <1>;
                        is-virtual-sensor;
                        thrd-low = <30>;
                        thrd-high = <300>;
                        als-type = <0>;
                };
                fp_display {
                        sensor-type = <3>;
                        is-virtual-sensor;
                        prox-type = <0>;
                };
                free_fall {
                        sensor-type = <4>;
                        is-virtual-sensor;
                };
        };

};

&qupv3_se4_spi {
 status = "ok";
 consumerIr@0 {
  compatible = "oplus,kookong_ir_spi";
  reg = <0>;
  status = "ok";
  spi-max-frequency = <5000000>;
  ir-spi-mode = <0>;
 };
};
# 10 "../arch/arm64/boot/dts/vendor/oplus/ziti/yupik-22813-overlay.dts" 2
# 1 "../arch/arm64/boot/dts/vendor/oplus/ziti/nfc/ziti-22813-nfc-sn220t.dtsi" 1
# 13 "../arch/arm64/boot/dts/vendor/oplus/ziti/nfc/ziti-22813-nfc-sn220t.dtsi"
&soc {

 nfc_chipset {
  compatible = "oplus-nfc-chipset";
  chipset-22813 = "SN220T";
 };
};

&qupv3_se9_i2c {
 status = "ok";
 qcom,clk-freq-out = <400000>;
 sn-nci@28 {
  compatible = "qcom,sn-nci";
  reg = <0x28>;
  qcom,sn-irq = <&tlmm 41 0x00>;
  qcom,sn-ven = <&tlmm 40 0x00>;
  qcom,sn-firm = <&tlmm 38 0x00>;
  qcom,sn-clkreq = <&tlmm 39 0x00>;
  interrupt-parent = <&tlmm>;
  interrupts = <41 0>;
  interrupt-names = "nfc_irq";
  pinctrl-names = "nfc_active", "nfc_suspend";
  pinctrl-0 = <&nfc_int_active &nfc_enable_active>;
  pinctrl-1 = <&nfc_int_suspend &nfc_enable_suspend>;
 };
};
# 11 "../arch/arm64/boot/dts/vendor/oplus/ziti/yupik-22813-overlay.dts" 2
/ {
 model = "Qualcomm Technologies, Inc. Yupik IDP";
 compatible = "qcom,yupik-idp", "qcom,yupik", "qcom,idp";
 qcom,board-id = <34 0>;
 oplus,dtsi_no = <22813>;
 oplus,pcb_range = <0 1450>;
};
