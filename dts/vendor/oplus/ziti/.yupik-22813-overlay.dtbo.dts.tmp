&pm7250b_bcl {
 qcom,support-12A;
};

&usb_qmp_dp_phy {
 status = "disabled";
};

&usb2_phy1 {
 status = "disabled";
};

&usb0 {
 /delete-property/ extcon;
 dwc3@a600000 {
  usb-phy = <&usb2_phy0>, <&usb_nop_phy>;
  snps,usb2-lpm-disable;
  maximum-speed = "high-speed";
  dr_mode = "otg";
 };
};

&usb1 {
 status = "disabled";
 dwc3@8c00000 {
  status = "disabled";
 };
};

&usb2_phy0 {
 qcom,param-override-seq =
   <0xe7 0x6c
    0xcc 0x70
    0x08 0x74
    0x70 0x78>;

 qcom,param-override-seq-host =
   <0x07 0x6c
    0xca 0x70
    0x08 0x74
    0x70 0x78>;
};

&pm7325_gpios {
 pa_4g_gpio_default: pa_4g_gpio_default {
  pins = "gpio1";
  function = "normal";
  bias-high-impedance;
 };
 pa_5g_gpio_default: pa_5g_gpio_default {
  pins = "gpio4";
  function = "normal";
  bias-high-impedance;
 };
};

&pm7250b_gpios {
 cp_therm_gpio_default: cp_therm_gpio_default {
  pins = "gpio8";
  function = "normal";
  bias-high-impedance;
 };
 bat_therm_a_board_gpio_default: bat_therm_a_board_gpio_default {
  pins = "gpio5";
  function = "normal";
  bias-high-impedance;
 };
};

&pmk8350_vadc {
 pinctrl-names = "default";
 pinctrl-0 = <&pa_4g_gpio_default &pa_5g_gpio_default>;

 pa_4g_adc {
  reg = <(1 << 8 | 0x48)>;
  label = "pa_4g_adc";
  qcom,pre-scaling = <1 1>;

  qcom,hw-settle-time = <200>;
  oplus,cust_type = <9>;
  oplus,cust_scale_fn_type = <6>;
 };
 pa_5g_adc {
  reg = <(1 << 8 | 0x4c)>;
  label = "pa_5g_adc";
  qcom,pre-scaling = <1 1>;

  qcom,hw-settle-time = <200>;
  oplus,cust_type = <9>;
  oplus,cust_scale_fn_type = <6>;
 };
};


&pm7250b_vadc {
 pinctrl-names = "default";
 pinctrl-0 = <&cp_therm_gpio_default &bat_therm_a_board_gpio_default>;

 cp_therm_adc {
  reg = <0x55>;
  label = "cp_therm_adc";
  qcom,pre-scaling = <1 1>;
  qcom,ratiometric;
  qcom,hw-settle-time = <200>;
  oplus,cust_type = <9>;
  oplus,cust_scale_fn_type = <6>;
 };
 bat_therm_a_board_adc {
  reg = <0x54>;
  label = "bat_therm_a_board_adc";
  qcom,pre-scaling = <1 1>;
  qcom,ratiometric;
  qcom,hw-settle-time = <200>;
  oplus,cust_type = <9>;
  oplus,cust_scale_fn_type = <6>;
 };
};

&pmk8350_adc_tm {
 io-channels = <&pmk8350_vadc (1 << 8 | 0x44)>,
   <&pmk8350_vadc (1 << 8 | 0x45)>,
   <&pmk8350_vadc (1 << 8 | 0x46)>,
   <&pmk8350_vadc (1 << 8 | 0x47)>,
   <&pmk8350_vadc (0 << 8 | 0x44)>,
   <&pmk8350_vadc (1 << 8 | 0x48)>,
   <&pmk8350_vadc (1 << 8 | 0x4c)>;

 pa_4g_therm {
  reg = <(1 << 8 | 0x48)>;
  qcom,ratiometric;
  qcom,hw-settle-time = <200>;
 };

 pa_5g_therm {
  reg = <(1 << 8 | 0x4c)>;
  qcom,ratiometric;
  qcom,hw-settle-time = <200>;
 };
};

&pm7250b_adc_tm {
 io-channels = <&pm7250b_vadc 0x4d>,
   <&pm7250b_vadc 0x4f>,
   <&pm7250b_vadc 0x55>,
   <&pm7250b_vadc 0x54>;

 cp_ic_therm {
  reg = <0x55>;
  qcom,ratiometric;
  qcom,hw-settle-time = <200>;
 };

 tbatt_a_therm {
  reg = <0x54>;
  qcom,ratiometric;
  qcom,hw-settle-time = <200>;
 };
};

&thermal_zones {
        pa_4g_therm-usr {
                polling-delay-passive = <0>;
                polling-delay = <0>;
                thermal-governor = "user_space";
                thermal-sensors = <&pmk8350_adc_tm (1 << 8 | 0x48)>;
                wake-capable-sensor;
                trips {
                        active-config0 {
                                temperature = <125000>;
                                hysteresis = <1000>;
                                type = "passive";
                        };
                };
        };

        pa_5g_therm-usr {
                polling-delay-passive = <0>;
                polling-delay = <0>;
                thermal-governor = "user_space";
                thermal-sensors = <&pmk8350_adc_tm (1 << 8 | 0x4c)>;
                wake-capable-sensor;
                trips {
                        active-config0 {
                                temperature = <125000>;
                                hysteresis = <1000>;
                                type = "passive";
                        };
                };
        };

        cp_ic_therm-usr {
                polling-delay-passive = <0>;
                polling-delay = <0>;
                thermal-governor = "user_space";
                thermal-sensors = <&pm7250b_adc_tm 0x55>;
                wake-capable-sensor;
                trips {
                        active-config0 {
                                temperature = <125000>;
                                hysteresis = <1000>;
                                type = "passive";
                        };
                };
        };

        tbatt_a_therm-usr {
                polling-delay-passive = <0>;
                polling-delay = <0>;
                thermal-governor = "user_space";
                thermal-sensors = <&pm7250b_adc_tm 0x54>;
                wake-capable-sensor;
                trips {
                        active-config0 {
                                temperature = <125000>;
                                hysteresis = <1000>;
                                type = "passive";
                        };
                };
        };
};


